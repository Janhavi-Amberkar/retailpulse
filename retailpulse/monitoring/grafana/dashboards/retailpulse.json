{
  "title": "RetailPulse - Model & Platform Health", "uid": "retailpulse", "schemaVersion": 39, "version": 1, "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "panels": [
    { "id": 1, "type": "stat", "title": "Weekly forecast MAPE %", "gridPos": { "x": 0, "y": 0, "w": 6, "h": 5 },
      "targets": [{ "expr": "retailpulse_forecast_mape{horizon=\"weekly\"}" }],
      "fieldConfig": { "defaults": { "unit": "percent", "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "orange", "value": 12 }, { "color": "red", "value": 18 }] } } } },
    { "id": 2, "type": "stat", "title": "Churn AUC-ROC", "gridPos": { "x": 6, "y": 0, "w": 6, "h": 5 },
      "targets": [{ "expr": "retailpulse_churn_auc" }],
      "fieldConfig": { "defaults": { "decimals": 3, "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "orange", "value": 0.75 }, { "color": "green", "value": 0.8 }] } } } },
    { "id": 3, "type": "gauge", "title": "Share of drifted features", "gridPos": { "x": 12, "y": 0, "w": 6, "h": 5 },
      "targets": [{ "expr": "retailpulse_drift_share" }],
      "fieldConfig": { "defaults": { "unit": "percentunit", "max": 1, "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "orange", "value": 0.15 }, { "color": "red", "value": 0.3 }] } } } },
    { "id": 4, "type": "timeseries", "title": "Dashboard page views / min", "gridPos": { "x": 0, "y": 5, "w": 12, "h": 8 },
      "targets": [{ "expr": "sum by (page) (rate(retailpulse_page_views_total[5m])) * 60", "legendFormat": "{{page}}" }] },
    { "id": 5, "type": "timeseries", "title": "Exports by kind", "gridPos": { "x": 12, "y": 5, "w": 12, "h": 8 },
      "targets": [{ "expr": "sum by (kind) (increase(retailpulse_exports_total[1h]))", "legendFormat": "{{kind}}" }] },
    { "id": 6, "type": "timeseries", "title": "Batch duration p95 (s) - SLO 300", "gridPos": { "x": 0, "y": 13, "w": 24, "h": 7 },
      "targets": [{ "expr": "histogram_quantile(0.95, sum(rate(retailpulse_batch_seconds_bucket[1h])) by (le))" }] }
  ]
}
